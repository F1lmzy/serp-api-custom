{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "search-archive",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./aio_viewer/static",
    "binding": "ASSETS",
    "run_worker_first": true
  }
  // Public viewer: attach your custom domain in the Cloudflare dashboard.
  // No Access application or login is required. Dashboard routes persist.
  // Set runtime variables/secrets in Worker Settings > Variables & Secrets.
  // See docs/cloudflare-workers.md. Database credentials stay server-side.
}
