# The CLI loads .env next to aio_scraper.py. Exported variables win.
# Credentials alone do not enable a proxy. Use 'dataimpulse' to opt in;
# --proxy direct or --proxy dataimpulse overrides this setting.
GOOGLE_AIO_PROXY=direct
DATAIMPULSE_PROXY_HOST=gw.dataimpulse.com
DATAIMPULSE_PROXY_PORT=823
DATAIMPULSE_PROXY_USER=
DATAIMPULSE_PROXY_PASSWORD=

# Optional. Set this to enable automatic CAPTCHA solving (2Captcha) when
# Google serves a /sorry challenge page. Leaving it empty keeps the old
# behavior of failing with a clear error instead of spending credits.
TWOCAPTCHA_API_KEY=

# Browser engine: 'chromium' for direct access, 'firefox' for DataImpulse.
GOOGLE_AIO_BROWSER=chromium

# Persistent browser profile directory. Keeps Google session cookies across
# runs so one solved CAPTCHA covers later searches. Set to 'off' for a fresh
# session per run. Use a different directory for each browser engine.
GOOGLE_AIO_PROFILE=.aio-profile

# Set GOOGLE_AIO_HEADLESS=0 to run with a visible browser window.
GOOGLE_AIO_HEADLESS=1

# Supabase remote SQL storage. Project ref is the 20-character project ID.
# Keep the secret key server-side. It can access data, not create tables.
SUPABASE_PROJECT_ID=
SUPABASE_SECRET_KEY=

# Personal access token for schema deployment and the current atomic batch
# uploader through the Management API. Create at:
# https://supabase.com/dashboard/account/tokens
# This is NOT the project secret key. Required for run_supabase_batch --upload.
SUPABASE_ACCESS_TOKEN=
